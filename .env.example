# Posy local configuration. Copy this file to .env.local and keep secrets out of Git.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

PRAVA_SECRET_KEY=
PRAVA_BASE_URL=https://sandbox.api.prava.space

# Linked Prava Pay agent used for live UCP product discovery. Keep the private
# key server-side. This build uses it only for search/product read endpoints.
PRAVA_AGENT_ID=
PRAVA_AGENT_PRIVATE_KEY=

# Set after deployment. Used for hosted payment return URLs and webhooks.
NEXT_PUBLIC_APP_URL=https://posy.getcontios.com

# Linq messaging channel (iMessage/RCS/SMS). Generate a token at
# dashboard.linqapp.com/api-tooling. LINQ_NUMBER is your assigned Linq number.
# Point the Linq webhook (message.received) at /api/linq/webhook.
LINQ_API_TOKEN=
LINQ_NUMBER=+16462395308
LINQ_BASE_URL=https://api.linqapp.com/api/partner/v3
# Optional: if set, /api/linq/webhook requires this value in x-linq-signature.
LINQ_WEBHOOK_SECRET=

# GitHub sign-in (optional). Create an OAuth app at
# github.com/settings/developers with callback
# https://posy.getcontios.com/api/auth/github/callback. Sign-in stays hidden
# until both are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
