# Posy local configuration. Copy this file to .env.local and keep secrets out of Git.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

PRAVA_SECRET_KEY=
PRAVA_BASE_URL=https://sandbox.api.prava.space

# Linked Prava Pay agent used for live UCP product discovery. Keep the private
# key server-side. This build uses it only for search/product read endpoints.
PRAVA_AGENT_ID=
PRAVA_AGENT_PRIVATE_KEY=

# Set after deployment. Used for hosted payment return URLs and webhooks.
NEXT_PUBLIC_APP_URL=https://posy.getcontios.com
