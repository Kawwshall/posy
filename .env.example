# Posy — environment configuration
# Copy to .env.local. Every value is OPTIONAL: with no keys, Posy runs a
# high-fidelity mock of both OpenAI and Prava so the full flow works offline.
# Add a key and that half goes live automatically — no code changes.

# --- OpenAI (agent brain) --------------------------------------------------
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model override (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# --- Prava (payments + trust layer) ----------------------------------------
# Create a sandbox secret key at https://dashboard.prava.space
# Must start with sk_test_ for sandbox.
PRAVA_SECRET_KEY=
# Optional base URL override (default: https://sandbox.api.prava.space)
PRAVA_BASE_URL=https://sandbox.api.prava.space
